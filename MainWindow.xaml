<Window x:Class="RobloxMacroStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RobloxMacroStudio"
        xmlns:models="clr-namespace:RobloxMacroStudio.Models"
        mc:Ignorable="d"
        Title="Roblox Macro Studio - 3D Viewport &amp; OpenCV 5 Vision Automation"
        Icon="Assets/app-icon.png"
        Height="920" Width="1440"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <!-- Style definitions -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A" />
        <SolidColorBrush x:Key="CardBg" Color="#1E293B" />
        <SolidColorBrush x:Key="CardBgHover" Color="#334155" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="AccentColor" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentHover" Color="#4F46E5" />
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981" />
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" />
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444" />
        <SolidColorBrush x:Key="CyanColor" Color="#06B6D4" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8" />

        <!-- Converter for Boolean to Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Base Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBgHover}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Green Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- Danger Red Button Style -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- TextBox Dark Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- CheckBox Dark Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TabControl Dark Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Top Control & Window Selector Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content: Left (Workflow) | Center (Preview & Snip) | Right (Inspector & 3D Guide) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Log Console & Action Bar -->
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- ================= TOP HEADER & TARGET WINDOW BAR ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="{StaticResource AccentColor}" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                        <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ROBLOX MACRO STUDIO" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}"/>
                            <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="OpenCV 5" FontSize="10" FontWeight="Bold" Foreground="#6EE7B7"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Roblox 3D Viewport Stabilization &amp; Inactive Background Control" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Target Window Selector Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0">
                    <TextBlock Text="Target Window:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" FontWeight="SemiBold" FontSize="12"/>

                    <!-- Refresh Windows Button -->
                    <Button Command="{Binding RefreshWindowsCommand}" ToolTip="Refresh active window list" Margin="0,0,6,0" Padding="8,5">
                        <TextBlock Text="🔄 Refresh"/>
                    </Button>

                    <!-- Target Window Dropdown -->
                    <ComboBox Width="320"
                              ItemsSource="{Binding OpenWindows}"
                              SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,8,0"/>

                    <!-- Crosshair Drag Target Finder -->
                    <Border x:Name="CrosshairBorder"
                            Background="#3730A3"
                            CornerRadius="6"
                            Padding="8,5"
                            Cursor="Cross"
                            ToolTip="Click &amp; Drag onto LDPlayer or Roblox window to lock target!"
                            MouseDown="CrosshairBorder_MouseDown"
                            MouseUp="CrosshairBorder_MouseUp"
                            MouseMove="CrosshairBorder_MouseMove">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="Drag to Target" FontWeight="Bold" Foreground="#E0E7FF" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Capture Snapshot Button -->
                    <Button Command="{Binding CapturePreviewCommand}" Margin="8,0,0,0" ToolTip="Take fresh snapshot of target window">
                        <TextBlock Text="📸 Snapshot"/>
                    </Button>

                    <!-- Background Mode Toggle -->
                    <CheckBox IsChecked="{Binding UseBackgroundInput, Mode=TwoWay}"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="PostMessage background input to RenderWindow (allows automating even when covered by other windows)">
                        <TextBlock Text="Inactive Background Mode" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                    </CheckBox>
                </StackPanel>

                <!-- Hotkey Tip & Status Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E1B4B" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" BorderBrush="#4338CA" BorderThickness="1">
                        <TextBlock Text="F5: Start | F7: Pause | F6: Stop" FontSize="11" Foreground="#C7D2FE" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Status Pill -->
                    <Border Background="{Binding StatusBadgeColor}" CornerRadius="12" Padding="12,4" MinWidth="80">
                        <TextBlock Text="{Binding StatusBadgeText}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT 3-COLUMN LAYOUT ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Left: Action Sequence Workflow Editor (350px) -->
                <ColumnDefinition Width="350" MinWidth="280"/>
                <!-- Center: Live Window Preview & Interactive Snipping (flex) -->
                <ColumnDefinition Width="*" MinWidth="350"/>
                <!-- Right: Action Inspector & 3D Stabilization Guide (390px) -->
                <ColumnDefinition Width="390" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: ACTION WORKFLOW ================= -->
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Script Settings Header & Presets -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Action Sequence" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding Script.Title}" FontSize="11" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Presets Dropdown & Script Save/Load Toolbar -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Presets Combo -->
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailablePresets}"
                                      SelectionChanged="PresetComboBox_SelectionChanged"
                                      ToolTip="Load Ready-made Presets"
                                      Margin="0,0,4,0"/>
                            <!-- Open / Save -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding LoadScriptCommand}" ToolTip="Load Script (.json)" Margin="0,0,4,0" Padding="6,3">
                                    <TextBlock Text="📂 Open"/>
                                </Button>
                                <Button Command="{Binding SaveScriptCommand}" ToolTip="Save Script (.json)" Padding="6,3">
                                    <TextBlock Text="💾 Save"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Loop Settings -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Loops:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                <TextBox Text="{Binding Script.LoopCount, Mode=TwoWay}" Width="45" HorizontalContentAlignment="Center" FontSize="11" ToolTip="0 = Infinite Loop"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Interval:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"/>
                                <TextBox Text="{Binding Script.LoopIntervalMs, Mode=TwoWay}" Width="50" HorizontalContentAlignment="Center" FontSize="11" ToolTip="Delay between loops (ms)"/>
                                <TextBlock Text="ms" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,0,0,0" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action ListBox -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Script.Actions}"
                             SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:MacroAction}">
                                <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,0,0,5" BorderBrush="#334155" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Enable Checkbox -->
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Action Summary Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#3730A3" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold" Foreground="#E0E7FF"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Add Action & Reorder Toolbar -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Add Action ComboBox/Menu -->
                        <Menu Grid.Column="0" Background="Transparent" Foreground="{StaticResource TextPrimary}">
                            <MenuItem Header="➕ Add Action" FontWeight="Bold" Background="{StaticResource AccentColor}" Foreground="#FFFFFF" Padding="10,6">
                                <MenuItem Header="🚶➡️🎯 Move Until Checkpoint &amp; Rotate (도달 시 멈추고 회전)" Command="{Binding AddActionCommand}" CommandParameter="MoveUntilCheckpoint"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="🔍 Find Image (OpenCV 5)" Command="{Binding AddActionCommand}" CommandParameter="FindImage"/>
                                <MenuItem Header="🎨 Find Color Blob (HSV)" Command="{Binding AddActionCommand}" CommandParameter="FindColor"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="🎯 3D Camera Reset (Roblox)" Command="{Binding AddActionCommand}" CommandParameter="RobloxCameraReset"/>
                                <MenuItem Header="🧭 3D Camera Sweep &amp; Align" Command="{Binding AddActionCommand}" CommandParameter="RobloxCameraSweep"/>
                                <MenuItem Header="🚶 Calibrated Walk (WASD)" Command="{Binding AddActionCommand}" CommandParameter="CalibratedMove"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="🖱️ Click Mouse" Command="{Binding AddActionCommand}" CommandParameter="Click"/>
                                <MenuItem Header="🖐️ Drag / Rotate View" Command="{Binding AddActionCommand}" CommandParameter="Drag"/>
                                <MenuItem Header="⌨️ Key Press" Command="{Binding AddActionCommand}" CommandParameter="KeyPress"/>
                                <Separator Background="#334155"/>
                                <MenuItem Header="⏳ Delay Wait" Command="{Binding AddActionCommand}" CommandParameter="Delay"/>
                                <MenuItem Header="🔀 Condition Branch" Command="{Binding AddActionCommand}" CommandParameter="ConditionBranch"/>
                                <MenuItem Header="📝 Log Message" Command="{Binding AddActionCommand}" CommandParameter="LogMessage"/>
                            </MenuItem>
                        </Menu>

                        <!-- Reorder / Delete Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding MoveActionUpCommand}" ToolTip="Move Up" Margin="0,0,4,0" Padding="8,5">
                                <TextBlock Text="▲"/>
                            </Button>
                            <Button Command="{Binding MoveActionDownCommand}" ToolTip="Move Down" Margin="0,0,4,0" Padding="8,5">
                                <TextBlock Text="▼"/>
                            </Button>
                            <Button Command="{Binding DuplicateActionCommand}" ToolTip="Duplicate" Margin="0,0,4,0" Padding="8,5">
                                <TextBlock Text="📋"/>
                            </Button>
                            <Button Command="{Binding DeleteActionCommand}" ToolTip="Delete" Style="{StaticResource DangerButton}" Padding="8,5">
                                <TextBlock Text="🗑️"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= CENTER: LIVE PREVIEW & INTERACTIVE SNIPPER ================= -->
            <Border Grid.Column="1" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Preview Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Target Window Preview &amp; Vision Canvas" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="{Binding SelectionStatusText}" FontSize="11" Foreground="{StaticResource CyanColor}"/>
                        </StackPanel>
                        <!-- Quick Calibration Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding QuickResetRobloxCameraCommand}" ToolTip="Reset Roblox Camera to Heading (I x8 -> O x5)" Margin="0,0,4,0" Padding="6,3">
                                <TextBlock Text="🧭 Reset 3D View"/>
                            </Button>
                            <Button Command="{Binding QuickTiltBirdEyeCommand}" ToolTip="Tilt to Top-Down Bird's Eye View" Margin="0,0,4,0" Padding="6,3">
                                <TextBlock Text="🦅 Top-Down"/>
                            </Button>
                            <Button Command="{Binding QuickShiftLockCommand}" ToolTip="Toggle Roblox Shift-Lock" Padding="6,3">
                                <TextBlock Text="🔒 Shift-Lock"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Image Viewer with Drag Selection Canvas -->
                    <Border Grid.Row="1" Background="#020617" CornerRadius="6" ClipToBounds="True" BorderBrush="#334155" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="PreviewCanvas"
                                    Width="{Binding PreviewImage.PixelWidth, FallbackValue=800}"
                                    Height="{Binding PreviewImage.PixelHeight, FallbackValue=600}"
                                    MouseDown="PreviewCanvas_MouseDown"
                                    MouseMove="PreviewCanvas_MouseMove"
                                    MouseUp="PreviewCanvas_MouseUp"
                                    Cursor="Cross"
                                    Background="Transparent">
                                <!-- Captured Window Image -->
                                <Image x:Name="CapturedImg"
                                       Source="{Binding PreviewImage}"
                                       Stretch="None"/>

                                <!-- Selection Rectangle (interactive ROI / template snip) -->
                                <Rectangle x:Name="SelectionVisualRect"
                                           Stroke="#06B6D4"
                                           StrokeThickness="2"
                                           Fill="#3306B6D4"
                                           Visibility="Collapsed"/>
                            </Canvas>
                        </ScrollViewer>
                    </Border>

                    <!-- Selection Action Bar -->
                    <Border Grid.Row="2" Background="#0F172A" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 Hint: Drag on screen to snip template or set ROI search area." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding SaveTemplateFromSelectionCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,6,0"
                                        Padding="8,4"
                                        ToolTip="Save selected area as a PNG template and link to action">
                                    <TextBlock Text="✂️ Snip Template PNG"/>
                                </Button>
                                <Button Command="{Binding SetRoiFromSelectionCommand}"
                                        Padding="8,4"
                                        ToolTip="Restrict search area to selected box">
                                    <TextBlock Text="📐 Set as ROI"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT: ACTION INSPECTOR & 3D GUIDE ================= -->
            <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl>
                    <!-- TAB 1: ACTION INSPECTOR -->
                    <TabItem Header="⚙️ Action Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel DataContext="{Binding SelectedAction}">
                                <!-- Empty state when no action is selected -->
                                <TextBlock Text="Select an action from the left list to configure its properties."
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12"
                                           Margin="0,20,0,0"
                                           HorizontalAlignment="Center"
                                           Visibility="{Binding DataContext.SelectedAction, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"/>

                                <!-- Action Basic Info -->
                                <TextBlock Text="ACTION PARAMETERS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentColor}" Margin="0,0,0,8"/>

                                <TextBlock Text="Action Name" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

                                <TextBlock Text="Action Type" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                <Border Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" Foreground="{StaticResource CyanColor}" FontSize="12"/>
                                </Border>

                                <!-- DYNAMIC PROPERTY EDITORS -->

                                <!-- 1. MoveUntilCheckpoint Parameters (Waypoint Navigation) -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                                        BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🎯 WAYPOINT ARRIVAL &amp; ROTATION SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanColor}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="Move Key (W,A,S,D)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox Text="{Binding KeyCode, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="Max Timeout (ms)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox Text="{Binding MaxDurationMs, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Arrival Condition Type" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <ComboBox SelectedItem="{Binding CheckpointType, Mode=TwoWay}"
                                                  ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:CheckpointCheckType}}}"
                                                  Margin="0,0,0,6"/>

                                        <TextBlock Text="Checkpoint Template Image" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding TemplateImagePath, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Padding="8,2" Click="BrowseTemplate_Click"/>
                                        </Grid>

                                        <TextBlock Text="Action When Checkpoint Reached" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" Margin="0,4,0,2"/>
                                        <ComboBox SelectedItem="{Binding ArrivalAction, Mode=TwoWay}"
                                                  ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:OnArrivalAction}}}"
                                                  Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                <TextBlock Text="Rotate Drag Pixels (120px = ~90°)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox Text="{Binding RotateDeltaPixels, Mode=TwoWay}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                <TextBlock Text="Arrival Key (e.g. E)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                <TextBox Text="{Binding ArrivalKey, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 2. FindImage Parameters -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Template Image Path" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding TemplateImagePath, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="..." Margin="4,0,0,0" Padding="8,2" Click="BrowseTemplate_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Confidence Threshold" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                            <Slider Minimum="0.5" Maximum="1.0" Value="{Binding MatchThreshold, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MatchThreshold, StringFormat={}{0:P0}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding UseMultiScale, Mode=TwoWay}" Margin="0,0,0,6">
                                        <TextBlock Text="Enable Multi-Scale (3D Zoom Invariant)" ToolTip="Tests scale variants (0.8x - 1.2x) to find target even when distance/zoom shifts"/>
                                    </CheckBox>

                                    <!-- ROI settings -->
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,4,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Region of Interest (ROI) (0 = Full Window)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,2,0">
                                                    <TextBlock Text="X" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding RoiX, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="2,0,2,0">
                                                    <TextBlock Text="Y" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding RoiY, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="2,0,2,0">
                                                    <TextBlock Text="W" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding RoiWidth, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="2,0,0,0">
                                                    <TextBlock Text="H" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding RoiHeight, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 3. FindColor Parameters (HSV) -->
                                <StackPanel Margin="0,0,0,8">
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="HSV Color Filtering (Immune to 3D lighting shifts)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CyanColor}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                    <TextBlock Text="Min H (0-180)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding HsvMinH, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                    <TextBlock Text="Max H (0-180)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding HsvMaxH, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,3,0">
                                                    <TextBlock Text="Min S (0-255)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding HsvMinS, Mode=TwoWay}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                                    <TextBlock Text="Max S (0-255)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                    <TextBox Text="{Binding HsvMaxS, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 4. Click Parameters -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Coordinate Source" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                    <ComboBox SelectedItem="{Binding CoordSource, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:CoordinateSource}}}"
                                              Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Target X (Fixed)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding TargetX, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Target Y (Fixed)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding TargetY, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Offset X" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding OffsetX, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Offset Y" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding OffsetY, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Mouse Button" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                    <ComboBox SelectedItem="{Binding MouseButton, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:MouseButtonType}}}"
                                              Margin="0,0,0,8"/>
                                </StackPanel>

                                <!-- 5. KeyPress / CalibratedMove Parameters -->
                                <StackPanel Margin="0,0,0,8">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Key Code (W,A,S,D,SPACE,etc)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding KeyCode, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Hold Duration (ms)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding KeyHoldDurationMs, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 6. Roblox 3D Camera Reset Parameters -->
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Camera Reset Mode" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                                    <ComboBox SelectedItem="{Binding CameraResetMode, Mode=TwoWay}"
                                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type models:RobloxCameraResetMode}}}"
                                              Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Zoom In Steps ('I')" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding ZoomInCount, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Zoom Out Steps ('O')" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                            <TextBox Text="{Binding ZoomOutCount, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- 7. Delay & Jitter Parameters -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="Delay (ms)" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                        <TextBox Text="{Binding DelayMs, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <CheckBox IsChecked="{Binding UseRandomJitter, Mode=TwoWay}" Margin="0,2,0,2">
                                            <TextBlock Text="Anti-Detection Jitter" FontSize="10"/>
                                        </CheckBox>
                                        <TextBox Text="{Binding JitterPercentage, Mode=TwoWay}" ToolTip="Random variance percentage (e.g. 15%)"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Single Action Test Button -->
                                <Button Content="▶️ Test This Action Now"
                                        Command="{Binding DataContext.TestCurrentActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,10,0,0"
                                        Padding="10,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: 3D STABILIZATION GUIDE -->
                    <TabItem Header="📖 3D Game Guide">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ROBLOX 3D STABILIZATION" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentColor}" Margin="0,0,0,6"/>
                                <TextBlock Text="Solving 3D perspective distortion &amp; camera drift:" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                                <!-- Waypoint Move Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#06B6D4" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🚀 Move Until Checkpoint &amp; Rotate" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="앞으로 이동하다 특정 체크포인트(아이콘/랜드마크/색상)에 도달하면 즉각 정지하고 화면을 90도 또는 원하는 각도로 회전합니다. 타임아웃 보호로 벽에 끼이는 현상을 방지합니다."
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Method 1 Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="1. First-Person Heading Snap" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="In Roblox, zooming all the way in with 'I' enters 1st person, locking camera yaw directly to avatar face. Then zooming out with 'O' restores exact reproducible 3rd-person distance!"
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Method 2 Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="2. 2D HUD Anchor Isolation" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="Always anchor reference templates on 2D Screen Space UI (health bar, backpack, compass needle, joystick) which NEVER distort or rotate regardless of 3D camera angles."
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Method 3 Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="3. Multi-Scale Template Matching" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="Enable 'Multi-Scale' on FindImage. It searches at 0.8x to 1.2x scale steps, detecting targets even if the avatar moved slightly closer or farther away in 3D depth."
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Method 4 Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="4. HSV Color Masking" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="Day/night cycle and shadows shift RGB colors, but HSV Hue stays intact! Use 'Find Color Blob' for quest markers, gold coins, or fishing meters."
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Method 5 Card -->
                                <Border Background="#0F172A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#334155" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="5. Top-Down Bird's Eye View" FontWeight="Bold" FontSize="12" Foreground="{StaticResource CyanColor}"/>
                                        <TextBlock Text="Right-click dragging upwards tilts the camera top-down, eliminating 3D perspective distortion into an orthographic 2D top-down plane!"
                                                   FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- ================= BOTTOM: EXECUTION CONSOLE & CONTROL BAR ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBg}" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Console Action Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Execution Logs" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <!-- Start Macro Button (F5) -->
                        <Button Command="{Binding StartMacroCommand}"
                                Style="{StaticResource SuccessButton}"
                                Margin="0,0,6,0"
                                Padding="16,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶️ START (F5)" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause / Resume Button (F7) -->
                        <Button Command="{Binding PauseMacroCommand}"
                                Margin="0,0,6,0"
                                Padding="14,6">
                            <TextBlock Text="⏸️ PAUSE (F7)"/>
                        </Button>

                        <!-- Stop Macro Button (F6) -->
                        <Button Command="{Binding StopMacroCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,10,0"
                                Padding="16,6">
                            <TextBlock Text="⏹️ STOP (F6)" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ClearLogsCommand}" Padding="8,4">
                            <TextBlock Text="🧹 Clear Logs"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Structured Log ListView -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding Logs}"
                          Background="#0F172A"
                          BorderBrush="#334155"
                          BorderThickness="1"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:MacroLogEntry}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Time -->
                                <TextBlock Grid.Column="0" Text="{Binding TimeString}" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>

                                <!-- Level Badge -->
                                <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>

                                <!-- Message -->
                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource TextPrimary}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Window>
